# Modeem AI Platform — example environment variables (no real secrets)

# API
ENVIRONMENT=development
DATABASE_URL=postgresql://modeem:modeem@localhost:5432/modeem
REDIS_URL=redis://localhost:6379/0

# Authentication (Phase 2A) — set a strong random value; never commit real secrets
AUTH_SECRET=<placeholder-change-me>

# Bootstrap admin (development only; never commit real values)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<placeholder-change-me>
BOOTSTRAP_TENANT_NAME=Example Tenant

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
